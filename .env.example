# ============================================================
# Speed Link Express — environment configuration
# Copy to `.env` and fill in. `.env` is git-ignored.
# ============================================================

# --- Supabase project (find these in Supabase > Project Settings > API) ---
SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxx"

# --- Same values, exposed to the browser bundle by Vite ---
# Only ever put PUBLISHABLE/anon keys behind the VITE_ prefix.
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxx"

# --- SERVER ONLY -------------------------------------------
# Bypasses RLS. Set this in your hosting provider's secret store
# (Vercel > Settings > Environment Variables), never in tracked source.
# NEVER prefix this with VITE_ — that would ship it to the browser.
SUPABASE_SERVICE_ROLE_KEY=""
